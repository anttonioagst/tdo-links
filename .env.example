PORT=4318
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4318
ADMIN_TOKEN=
DATA_FILE=data/db.json
AUTO_MODE=limited
AUTO_PUBLISH_THRESHOLD=85
REVIEW_THRESHOLD=70
SCRAPE_INTERVAL_MINUTES=60
PUBLISH_INTERVAL_MINUTES=10
SCRAPER_MODE=mock
SCRAPER_FALLBACK_MOCK=true
AMAZON_SEARCH_URLS=https://www.amazon.com.br/s?k=logitech,https://www.amazon.com.br/s?k=hyperx,https://www.amazon.com.br/s?k=razer,https://www.amazon.com.br/s?k=jbl,https://www.amazon.com.br/s?k=anker+soundcore,https://www.amazon.com.br/s?k=sony+fone,https://www.amazon.com.br/s?k=kingston+ssd,https://www.amazon.com.br/s?k=samsung+ssd,https://www.amazon.com.br/s?k=lg+ultragear,https://www.amazon.com.br/s?k=tp+link+deco,https://www.amazon.com.br/s?k=notebook+dell,https://www.amazon.com.br/s?k=notebook+lenovo,https://www.amazon.com.br/s?k=smart+tv+samsung,https://www.amazon.com.br/s?k=smart+tv+lg,https://www.amazon.com.br/s?k=mesa+gamer,https://www.amazon.com.br/s?k=mesa+escrivaninha
PREMIUM_BRANDS=logitech,hyperx,razer,sony,jbl,samsung,lg,dell,kingston,sandisk,anker,soundcore,tp-link,corsair,steelseries,crucial,wd,aoc,asus,lenovo,acer,tcl,hisense,husky,elements,flexform
SECONDARY_BRANDS=redragon,havit,c3tech,baseus,ugreen
PREMIUM_CURATION_MIN_SCORE=30
MAX_PREMIUM_CATEGORY_PER_WINDOW=1
AFFILIATE_DISCLOSURE=Link de afiliado: posso receber comissao pela compra.
AMAZON_AFFILIATE_TAG=
AMAZON_AFFILIATE_TAG_TELEGRAM=
AMAZON_AFFILIATE_TAG_X=
AMAZON_AFFILIATE_TAG_ADMIN=
AMAZON_CREATOR_URL=
MERCADO_LIVRE_AFFILIATE_PARAM=
# Examples:
# AMAZON_AFFILIATE_TAG=seudominio-20
# AMAZON_AFFILIATE_TAG_TELEGRAM=seudominio-tg-20
# AMAZON_AFFILIATE_TAG_X=seudominio-x-20
# AMAZON_CREATOR_URL=https://www.amazon.com.br/shop/seuperfil
# MERCADO_LIVRE_AFFILIATE_PARAM=matt_tool=123456
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DRY_RUN=true
X_DRY_RUN=true
X_PROFILE_URL=

# X (Twitter) API credentials para publicação real
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Discord webhook para publicação em servidor
DISCORD_WEBHOOK_URL=
DISCORD_DRY_RUN=true

# Discord bot para configurar servidor, canais publicos e TDO OPS privado
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_NAME=Admin TDO
DISCORD_SETUP_ENABLED=false

# Meta (Facebook + Instagram) — publisher orgânico + Meta Ads
# Guia completo: docs/marketing/meta-setup.md
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=        # Page Token (nunca expira) — ver guia
META_PAGE_ID=             # ID da Página do Facebook
META_IG_USER_ID=          # ID da conta Instagram Business
META_AD_ACCOUNT_ID=       # formato: act_XXXXXXXXXX
META_PIXEL_ID=            # ID do Pixel (para BOF com Conversões)
DISCORD_OPS_ENABLED=true
DISCORD_PUBLIC_DEALS_ENABLED=false

# Supervisor autonomo para incidentes conhecidos
SUPERVISOR_ENABLED=true
SUPERVISOR_INTERVAL_MINUTES=5
SUPERVISOR_STALE_TELEGRAM_MINUTES=90

# Orquestrador autonomo (1 agente que decide e roda todo o ciclo).
# Quando true, o worker usa o orquestrador no lugar do cron de discovery + supervisor + recovery.
# Nao exige Redis. Requer ANTHROPIC_API_KEY.
ORCHESTRATOR_ENABLED=false
ORCHESTRATOR_INTERVAL_MINUTES=15
ORCHESTRATOR_MODEL=claude-haiku-4-5-20251001
ORCHESTRATOR_MAX_STEPS=24
